[gd_scene load_steps=3 format=3 uid="uid://hud001"]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/inventory_panel.gd" id="2_inventory"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="MarginContainer" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
size_flags_vertical = 0

[node name="TopBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="MedallionLabel" type="Label" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Medalhão: 0/3"

[node name="Spacer" type="Control" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SaveExitButton" type="Button" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
text = "Salvar e Sair"

[node name="PromptLabel" type="Label" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Pressione E para interagir"
visible = false

[node name="InventoryPanel" type="Control" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -120.0
offset_right = 240.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_inventory")

[node name="Panel" type="PanelContainer" parent="InventoryPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
visible = false

[node name="MarginContainer" type="MarginContainer" parent="InventoryPanel/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="InventoryPanel/Panel/MarginContainer"]
layout_mode = 2

[node name="Title" type="Label" parent="InventoryPanel/Panel/MarginContainer/VBox"]
layout_mode = 2
text = "Inventário — Medalhão"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="InventoryPanel/Panel/MarginContainer/VBox"]
layout_mode = 2
text = "Pressione I para fechar"
horizontal_alignment = 1

[node name="Slots" type="HBoxContainer" parent="InventoryPanel/Panel/MarginContainer/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[connection signal="pressed" from="MarginContainer/VBox/TopBar/SaveExitButton" to="." method="_on_save_exit_pressed"]
